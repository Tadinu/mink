                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <velocity joint="joint1" ctrlrange="-2.0 2.0" ctrllimited="true" kv="500"/>
        <velocity joint="joint2" ctrlrange="-2.0 2.0" ctrllimited="true" kv="500"/>
        <velocity joint="joint3" ctrlrange="-2.0 2.0" ctrllimited="true" kv="500"/>
    </actuator>

    <keyframe>
        <key name="home" qpos="0 0.5 0" ctrl="0 0 0"/>
    </keyframe>
</mujoco>
