    <worldbody>
        <body name="link0" gravcomp="1">
            <geom name="link0" size="0.1" pos="0 0 0.1" type="sphere" material="cube"/>
            <body name="link1" pos="0 0 0.1" gravcomp="1">
                <inertial pos="0 0 0.5" mass="1" diaginertia="0.0858 0.0858 0.005"/>
                <joint name="joint1" pos="0 0 0" axis="1 0 0" range="-2.8973 2.8973" actuatorfrcrange="-87 87"/>
                <geom name="link1" size="0.1 0.5" pos="0 0 0.6" type="cylinder"/>
                <body name="link2" pos="0 0.0 1.2" quat="1 -1 0 0" gravcomp="1">
                    <inertial pos="0 0.0 0.2" mass="1" diaginertia="0.0858 0.0858 0.005"/>
                    <joint name="joint2" pos="0 0.0 0" axis="0 1 0" range="-2.8973 2.8973" actuatorfrcrange="-87 87"/>
                    <geom name="link2" size="0.1 0.15" pos="0 0 0.05" type="cylinder"/>
                    <body name="link3" pos="0 0 0.15" gravcomp="1">
