<mujoco model="default_scene">
  <compiler angle="radian" meshdir="meshes" texturedir="textures" />

  <visual>
    <quality shadowsize="4000" offsamples="4" numslices="64" numstacks="64" />
    <headlight active="1" />
    <rgba haze="0.15 0.25 0.35 1" />
  </visual>

  <size njmax="500" nconmax="100" />

  <!-- <option timestep="0.002" integrator="Euler" iterations="50" noslip_iterations="50" impratio="5" solver="Newton" tolerance="1e-8" cone="pyramidal"> -->
  <option timestep="0.002">
    <flag actuation="enable" gravity="enable" warmstart="enable" />
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512" />
    <texture name="plane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
    <material name="plane" reflectance="0" texture="plane" texrepeat="1 1" texuniform="true" />
  </asset>

  <worldbody>

    <light directional="true" diffuse=".2 .2 .2" specular="0 0 0" pos="0 1 5" dir="0 -1 -1" castshadow="false"/>
    <light directional="false" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -1 4" dir="0 0 -1" />
    <light directional="true" diffuse="0 0 0" specular=".7 .7 .7" pos="0 3 3" dir="0 -3 -3" />
    <geom name="floor" pos="0 0 0" group="1" size="0 0 .1" type="plane" material="plane" condim="3" />

    <body name="table" pos="0.7 0 0.7">
      <geom name="table" size="0.37 0.61 0.1" type="box"/>
    </body>
    <body mocap="true" name="left_target" pos="0.75 0 1.5">
      <geom name="left_target" group="1" type="sphere" size="0.05" rgba="1 0 0 1" conaffinity="0" contype="0"/>
    </body>
    <body mocap="true" name="right_target" pos="-0.75 0 1.5">
      <geom name="right_target" group="1" type="sphere" size="0.05" rgba="0 1 0 1" conaffinity="0" contype="0"/>
    </body>
    <body name="box" pos="0.7 0 1.5">
      <freejoint/>
      <geom name="box" type="box" size="0.03 0.03 0.03" condim="6" friction="1 5e-3 5e-4"
            rgba=".1 .6 .1 1" group="0"/>
    </body>
  </worldbody>

  <sensor>
    <user name="Reach L" dim="3" user="2 .1  0 .5 0.01"/>
    <user name="Reach R" dim="3" user="2 .1  0 .5 0.01"/>
    <user name="Grasp" dim="1"   user="-1 .05 0 .5"/>
    <user name="CoBring" dim="3"   user="2 .4  0 1 0.003"/>

    <framepos name="box_to_left_gripper" objtype="body" objname="box" reftype="site" refname="left_ee_site"/>
    <framepos name="box_to_right_gripper" objtype="body" objname="box" reftype="site" refname="right_ee_site"/>
    <framepos name="box" objtype="body" objname="box"/>
    <framepos name="fingerLL" objtype="body" objname="left_leftfinger"/>
    <framepos name="fingerLR" objtype="body" objname="left_rightfinger"/>
    <framepos name="fingerRL" objtype="body" objname="right_leftfinger"/>
    <framepos name="fingerRR" objtype="body" objname="right_rightfinger"/>
    <framepos name="left_target" objtype="body" objname="left_target"/>
    <framepos name="right_target" objtype="body" objname="right_target"/>
    <framepos name="trace0" objtype="site" objname="left_ee_site"/>
    <framepos name="trace1" objtype="site" objname="right_ee_site"/>
    <framepos name="trace2" objtype="geom" objname="box"/>
  </sensor>

  <!-- This, due to also having internal <sensor> downstream, must be added after <sensor> above -->
  <include file="garmi.xml" />
</mujoco>
